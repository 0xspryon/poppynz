ENVIRONMENT=dev

# DB
DB_NAME=poppynz_dev
DB_USER=user
DB_PASS=pass
DB_HOST=postgres
DB_PORT=5432
DB_DIALECT=postgresql
DATABASE_URL="jdbc:postgresql://localhost:5432/poppynz_dev"
# Semicolon-separated UI origins allowed as magic-link callback targets.
# Defaults (in @repo/env) are the production origins, so dev must set this.
TRUSTED_ORIGINS=http://localhost:5173;http://localhost:5174
REDIS_URL=redis://redis:6379
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=typesense-dev-key
TYPESENSE_PROVIDER_COLLECTION=service_providers
TYPESENSE_PROVIDER_COLLECTION_ALIAS=service_providers_current
TYPESENSE_PROVIDER_COLLECTION_VERSION=service_providers_v1
PROVIDER_SEARCH_MIN_RADIUS_KM=10
TYPESENSE_FAMILY_COLLECTION=families
TYPESENSE_FAMILY_COLLECTION_ALIAS=families_current
TYPESENSE_FAMILY_COLLECTION_VERSION=families_v2
FAMILY_SEARCH_MIN_RADIUS_KM=10
SERVICES_OFFERED_MAX_PER_PROVIDER=20
SERVICES_NEEDED_MAX_PER_FAMILY=20
QUEUE_UI_USERNAME=admin
QUEUE_UI_PASSWORD=admin
WORKER_HTTP_PORT=3001

# Better-auth
BETTER_AUTH_SECRET=0uEXwCHo0MTNcLbD98Qd8fmG8d5Wsqkz
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Rustfs
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
OBJS_KYC_BUCKET=kyc-documents
OBJS_PUBLIC_BUCKET=public-assets

# Google Maps / Places
GOOGLE_MAPS_API_KEY=your-server-side-google-maps-api-key

# Magic-link callback origins (dev UIs)
TRUSTED_ORIGINS="http://localhost:5173;http://localhost:5174;http://localhost:5175"

# Mail (Resend). Leave RESEND_API_KEY unset in dev to log mails to stdout
# instead of sending them (the magic-link sign-in recipe reads the log line).
RESEND_API_KEY=xx_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Poppynz <no-reply@poppynz.com>"
# Comma-separated admin addresses notified when a provider submits an
# approval request. Empty/unset means no admin notifications.
ADMIN_NOTIFICATION_EMAILS="springfield@poppynz.com;kay@poppynz.com"

# Credibled
CREDIBLED_BASE_URL=https://api.credibled.com/api/external/v1
CREDIBLED_PROVIDER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CREDIBLED_PROVIDER_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CREDIBLED_REQUEST_TIMEOUT_MS=15000

# Stripe — test mode only (live keys are refused at boot). PAYMENTS_PROVIDER is
# mock (default; nothing is charged) or stripe. STRIPE_WEBHOOK_SECRET comes from
# `stripe listen --print-secret` locally, or the dashboard endpoint elsewhere.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
# A payment left unconfirmed is re-checked after this many minutes, and
# cancelled (its order back to the basket) after this many hours.
PAYMENTS_SETTLE_AFTER_MINUTES=10
PAYMENTS_ABANDON_AFTER_HOURS=24

# --- Helper payout accounts (Stripe Connect, piece 2b) ---
# The web origin Stripe's hosted onboarding returns to (production default
# https://app.poppynz.com). Local web runs on 5175.
APP_WEB_ORIGIN=http://localhost:5175
# Re-fetch a helper's payout status from Stripe when the stored one is older.
PAYOUTS_REFRESH_AFTER_MINUTES=60

# Signing secret of the Connect webhook endpoint (staging/live only; local
# `stripe listen` uses STRIPE_WEBHOOK_SECRET for both streams).
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Contract billing (piece 3) ---
# Commissions in basis points, frozen on each contract at acceptance.
CONTRACT_FAMILY_COMMISSION_BPS=500
CONTRACT_PROVIDER_COMMISSION_BPS=1500
# A declined hold is retried this often during its grace period (and at once
# when the family replaces the card).
CONTRACT_BILLING_RETRY_HOURS=12
# Each cycle is held on the family's card this many hours before it starts
# (1-72; the declined-hold grace period runs from the hold to the start).
# Only cycles planned after a change use the new value.
CONTRACT_HOLD_LEAD_HOURS=24
# Terms can be sent and accepted until this many minutes before the first
# session starts (60-10080).
CONTRACT_MIN_LEAD_MINUTES=120
# Dated sessions exist this many days ahead (1-60); session actions only act
# on sessions that exist, and the UI explains the window with this number.
CONTRACT_SESSION_WINDOW_DAYS=14

# --- Session resolution (Tier 3) ---
# A family cancellation at least this many hours before a session (same
# wall-clock time in the contract zone) is early and free (1-168). Unanswered
# day-off proposals lapse at that cutoff.
CONTRACT_CANCELLATION_NOTICE_HOURS=24
# The other side has this many hours to accept or contest a report; silence
# counts as acceptance (1-336).
CONTRACT_REPORT_RESPONSE_HOURS=48
# Reports and disputes can be filed until this many hours after a session
# ends (1-336).
CONTRACT_REPORT_WINDOW_HOURS=48
# The helper's compensation for a late family cancellation, no-show or early
# dismissal: this share of the cancelled care value, in basis points
# (0-10000), rounded half up for the helper.
CONTRACT_LATE_CANCELLATION_HELPER_BPS=2500

# --- Session money and helper transfers (Tier 3 step 2) ---
# Each cycle's transfer to the helper is made this many hours after the cycle
# ends (0-336). Cycles already planned keep their stored transfer time.
CONTRACT_TRANSFER_DELAY_HOURS=48
# A payable that can't be transferred (payout account restricted or not
# ready) moves to the admins' manual payout queue after this many days (1-365).
CONTRACT_MANUAL_PAYOUT_AFTER_DAYS=60
# A refund the payment provider could not be reached for is retried every
# tick; after this many attempts the admins and accountant are alerted (1-1000).
CONTRACT_REFUND_ALERT_AFTER_ATTEMPTS=8

# --- Extra sessions (Tier 3 step 3) ---
# Either side may add a session the other confirms. It may be dated up to this
# many days in the past (a session that took place), 0-60.
CONTRACT_EXTRA_SESSION_LOOKBACK_DAYS=14
# Once both sides agreed, the family's card is charged after this many minutes
# (0-1440); until then either side can cancel it at no cost. Unanswered
# proposals lapse after CONTRACT_REPORT_RESPONSE_HOURS: silence is never
# acceptance, because it is a charge.
CONTRACT_EXTRA_SESSION_CHARGE_DELAY_MINUTES=60
# An extra session whose own charge is still unpaid this many days after it
# was due raises an admin incident (1-90). The regular contract is never
# suspended for it.
CONTRACT_EXTRA_SESSION_UNPAID_ALERT_DAYS=7
# A declined extra-session charge is retried every CONTRACT_BILLING_RETRY_HOURS,
# at most this many automatic attempts in all (1-100); a new card always
# retries it at once.
CONTRACT_EXTRA_SESSION_MAX_CHARGE_ATTEMPTS=15
# The shortest extra session that may be proposed, in minutes (1-720).
CONTRACT_EXTRA_SESSION_MIN_MINUTES=15

# --- Accountant reconciliation with Stripe (Tier 3 step 5) ---
# The worker imports Stripe's balance transactions this often, in hours
# (1-168), re-reading this many days back each time (1-120): statuses and
# payouts settle days after a transaction is created.
RECONCILIATION_INTERVAL_HOURS=24
RECONCILIATION_LOOKBACK_DAYS=35
# The longest period an admin or the accountant may import on demand (1-400).
RECONCILIATION_MAX_RANGE_DAYS=93
# Stripe page size (1-100) and the most pages one run reads (1-10000) before
# it stops and reports itself incomplete.
RECONCILIATION_PAGE_SIZE=100
RECONCILIATION_MAX_PAGES=200
# Sales tax is NOT configured here: it lives in the tax_* tables (seeded).
# Dev only: the billing clock and fixture in apps/worker/src/dev also need
# ENVIRONMENT=dev and BILLING_DEV_CLOCK=enabled on their command line.
