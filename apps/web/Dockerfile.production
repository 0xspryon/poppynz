# syntax=docker/dockerfile:1
# Production image for the SvelteKit web app (adapter-node).
# Build context is the repo root:
#   docker build -f apps/web/Dockerfile.production .

ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION}-alpine AS base
WORKDIR /usr/src/app

# Manifest-only layer so source edits don't invalidate the install cache.
FROM base AS deps
COPY package.json bun.lock turbo.json ./
COPY apps/api/package.json apps/api/
COPY apps/docs/package.json apps/docs/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/env/package.json packages/env/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/google/package.json packages/google/
COPY packages/mail/package.json packages/mail/
COPY packages/objs/package.json packages/objs/
COPY packages/queue/package.json packages/queue/
COPY packages/seeder/package.json packages/seeder/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/typesense/package.json packages/typesense/
COPY packages/ui/package.json packages/ui/
RUN bun install --frozen-lockfile

FROM deps AS build
COPY . .
ENV TURBO_TELEMETRY_DISABLED=1
# turbo builds `api` first (web imports api/hc from apps/api/dist).
RUN bunx turbo run build --filter=web

# Serve the adapter-node output with Node. adapter-node keeps production
# dependencies external and workspace links resolve against the repo root,
# so the whole workspace ships into the runtime image.
FROM node:24-alpine AS web
ENV NODE_ENV=production
WORKDIR /usr/src/app/apps/web
COPY --from=build /usr/src/app /usr/src/app
EXPOSE 3000
CMD ["node", "build"]
