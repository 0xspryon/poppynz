{
  "name": "with-svelte",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "check-types": "turbo run check-types",
    "dev:ngrok": "ngrok start poppynz"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "turbo": "^2.9.16"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/bun": "^1.3.14",
    "i": "^0.3.7"
  }
}
