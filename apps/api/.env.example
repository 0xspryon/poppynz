ENVIRONMENT=dev

# DB
DB_NAME=poppynz_dev
DB_USER=user
DB_PASS=pass
DB_HOST=postgres
DB_PORT=5432
DB_DIALECT=postgresql
DATABASE_URL="jdbc:postgresql://localhost:5432/poppynz_dev"
# Semicolon-separated UI origins allowed as magic-link callback targets.
# Defaults (in @repo/env) are the production origins, so dev must set this.
TRUSTED_ORIGINS=http://localhost:5173;http://localhost:5174
REDIS_URL=redis://redis:6379
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=typesense-dev-key
TYPESENSE_PROVIDER_COLLECTION=service_providers
TYPESENSE_PROVIDER_COLLECTION_ALIAS=service_providers_current
TYPESENSE_PROVIDER_COLLECTION_VERSION=service_providers_v1
PROVIDER_SEARCH_MIN_RADIUS_KM=10
TYPESENSE_FAMILY_COLLECTION=families
TYPESENSE_FAMILY_COLLECTION_ALIAS=families_current
TYPESENSE_FAMILY_COLLECTION_VERSION=families_v1
FAMILY_SEARCH_MIN_RADIUS_KM=10
SERVICES_OFFERED_MAX_PER_PROVIDER=20
SERVICES_NEEDED_MAX_PER_FAMILY=20
QUEUE_UI_USERNAME=admin
QUEUE_UI_PASSWORD=admin
WORKER_HTTP_PORT=3001

# Better-auth
BETTER_AUTH_SECRET=0uEXwCHo0MTNcLbD98Qd8fmG8d5Wsqkz
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Rustfs
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
OBJS_KYC_BUCKET=kyc-documents
OBJS_PUBLIC_BUCKET=public-assets

# Google Maps / Places
GOOGLE_MAPS_API_KEY=your-server-side-google-maps-api-key

# Magic-link callback origins (dev UIs)
TRUSTED_ORIGINS="http://localhost:5173;http://localhost:5174;http://localhost:5175"

# Mail (Resend). Leave RESEND_API_KEY unset in dev to log mails to stdout
# instead of sending them (the magic-link sign-in recipe reads the log line).
RESEND_API_KEY=xx_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Poppynz <no-reply@poppynz.com>"
# Comma-separated admin addresses notified when a provider submits an
# approval request. Empty/unset means no admin notifications.
ADMIN_NOTIFICATION_EMAILS="springfield@poppynz.com;kay@poppynz.com"

# Credibled
CREDIBLED_BASE_URL=https://api.credibled.com/api/external/v1
CREDIBLED_PROVIDER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CREDIBLED_PROVIDER_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CREDIBLED_REQUEST_TIMEOUT_MS=15000

