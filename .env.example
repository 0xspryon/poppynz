DB_NAME=poppynz_dev
DB_USER=user
DB_PASS=pass
DB_HOST=postgres
DB_PORT=5432
DB_DIALECT=postgresql
DATABASE_URL="jdbc:postgresql://localhost:5432/poppynz_dev"
REDIS_URL=redis://redis:6379
# Days an ignored reach-out blocks the family/provider pair before either side
# may reach out afresh (~4 months).
REACHOUT_IGNORE_COOLDOWN_DAYS=120
# Days a sent contract proposal (or amendment) stays acceptable before it
# presents as expired.
CONTRACT_PROPOSAL_EXPIRY_DAYS=14
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=typesense-dev-key
TYPESENSE_PROVIDER_COLLECTION=service_providers
TYPESENSE_PROVIDER_COLLECTION_ALIAS=service_providers_current
TYPESENSE_PROVIDER_COLLECTION_VERSION=service_providers_v1
PROVIDER_SEARCH_MIN_RADIUS_KM=10
TYPESENSE_FAMILY_COLLECTION=families
TYPESENSE_FAMILY_COLLECTION_ALIAS=families_current
TYPESENSE_FAMILY_COLLECTION_VERSION=families_v1
FAMILY_SEARCH_MIN_RADIUS_KM=10
QUEUE_UI_USERNAME=admin
QUEUE_UI_PASSWORD=admin
WORKER_HTTP_PORT=3001
# --- Credibled (safety verification, Path A) ---
# Without a key the client stays in log-mode: orders are logged, never sent or
# billed. Each audience is a separate Credibled account with its own webhook
# secret; only the helper (service provider) account is wired up so far.
CREDIBLED_BASE_URL=https://api.credibled.com/api/external/v1
CREDIBLED_PROVIDER_API_KEY=
CREDIBLED_PROVIDER_WEBHOOK_SECRET=
CREDIBLED_REQUEST_TIMEOUT_MS=15000
# --- Safety verification policy ---
# Credibled reports completion but no expiry, so validity is Poppynz policy.
SAFETY_VERIFICATION_VALIDITY_MONTHS=12
SAFETY_VERIFICATION_EXPIRY_REMINDER_DAYS=30
SAFETY_VERIFICATION_CONSENT_POLICY_VERSION=2026-08-22
# Credibled's API exposes no pricing, so the vendor cost is configured.
SAFETY_VERIFICATION_CHECK_COST_CENTS=5500
SAFETY_VERIFICATION_ADMIN_FEE_CENTS=500
# Placeholder until Stripe Tax lands in the payment PR.
SAFETY_VERIFICATION_TAX_RATE_BASIS_POINTS=0
SAFETY_VERIFICATION_ORDER_MAX_ATTEMPTS=3
