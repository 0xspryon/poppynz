{
  "name": "api",
  "exports": {
    ".": "./src/index.ts",
    "./hc": {
      "types": "./dist/hc.d.ts",
      "default": "./dist/hc.js"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run src/routes/app/auth/signup/signup.unit.test.ts",
    "test:e2e": "vitest run src/routes/app/auth/signup/signup.e2e.test.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.15",
    "@better-auth/i18n": "1.6.15",
    "@effect/sql": "^0.51.1",
    "@repo/db": "*",
    "@repo/env": "*",
    "@repo/google": "*",
    "@repo/mail": "*",
    "@repo/objs": "*",
    "@repo/queue": "*",
    "@repo/typesense": "*",
    "better-auth": "1.6.15",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "hono": "^4.12.25",
    "ts-punycode": "^0.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsx": "^4.22.4",
    "vitest": "^4.1.0",
    "typescript": "5.9.3"
  }
}
